{
  "name": "warrantycheck",
  "version": "1.0.4",
  "description": "CLI tool for checking device warranty status across Dell, HP, and Lenovo",
  "keywords": [
    "warranty",
    "dell",
    "hp",
    "lenovo",
    "cli",
    "fleet",
    "device-management"
  ],
  "author": "ironleaf",
  "license": "MIT",
  "repository": "https://github.com/Fe-Leaf/WarrantyCheck",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "warrantycheck": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node --require tsx/cjs --test src/validate.test.ts src/output.test.ts src/csv.test.ts src/config.test.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "exceljs": "^4.4.0",
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
